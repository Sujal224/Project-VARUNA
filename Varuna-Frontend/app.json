{
  "expo": {
    "name": "VARUNA",
    "slug": "project-varuna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#02060e",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VARUNA requires real-time GPS location for marine navigation, live weather telemetry, and Potential Fishing Zone tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#02060e"
      },
      "package": "com.varuna.marineintelligence",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_700Bold.ttf",
            "node_modules/@expo-google-fonts/playfair-display/PlayfairDisplay_500Medium.ttf",
            "node_modules/@expo-google-fonts/playfair-display/PlayfairDisplay_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/playfair-display/PlayfairDisplay_700Bold.ttf"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VARUNA requires real-time GPS location for marine navigation, live weather telemetry, and Potential Fishing Zone tracking."
        }
      ]
    ]
  }
}
